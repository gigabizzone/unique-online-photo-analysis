# ─── Database (Supabase) ─────────────────────────────────
# Get these from Supabase → Project Settings → Database → Connection string
# DATABASE_URL = pooled (port 6543, transaction mode)
# DIRECT_URL   = direct (port 5432) — required by Prisma migrations
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Supabase API (for Storage uploads / client helpers) ─
# Get these from Supabase → Project Settings → API
# Modern Supabase (2024+) uses sb_publishable_* (public) and sb_secret_* (server)
# keys. The old JWT-style anon / service_role keys also still work.
#
# NEXT_PUBLIC_SUPABASE_URL              = project URL, safe in browser
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  = public/anon key (RLS-bound), safe in browser
# SUPABASE_SECRET_KEY                   = service-role key, SERVER ONLY,
#                                         never expose to the browser
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# ─── Auth (NextAuth) ─────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (Hostinger SMTP) ──────────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@auraphotoscience.com"
SMTP_PASS=""
EMAIL_FROM="Aura Photo Science <info@auraphotoscience.com>"
ADMIN_EMAIL="mike2548@gmail.com"

# ─── App branding ────────────────────────────────────────
APP_NAME="Unique Online Photo Analysis"
APP_URL="http://localhost:3000"
APP_SLOGAN_EN="World's first-of-its-kind online service"
APP_SLOGAN_HI="विश्व में अपनी तरह की पहली ऑनलाइन सेवा।"
APP_TAGLINE="AT AURA PHOTO SCIENCE – WE TRANSFORM YOUR LIFE."

# ─── Social links ────────────────────────────────────────
